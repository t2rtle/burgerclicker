{
  "id": "/",
  "name": "Burger Clicker",
  "short_name": "Burger Clicker",
  "description": "🍔 Burger Clicker: an idle burger clicker game with pets, upgrades, Rebirths, and endless progression.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#fff8e9",
  "theme_color": "#fff8e9",
  "categories": [
    "games",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/media/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/media/pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+burgerclicker",
      "url": "/?protocolo=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
